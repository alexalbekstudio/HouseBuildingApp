{
  "name": "housebuilding-standalone",
  "productName": "HouseBuilding Standalone",
  "version": "2.4.0",
  "description": "Aplikacija za pracenje faza i troskova izgradnje kuce",
  "main": "electron_main.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/app.js",
    "start": "node src/app.js",
    "desktop": "electron .",
    "build:exe": "npx @electron/packager . HouseBuilding_Standalone --platform=win32 --arch=x64 --out=dist --overwrite --ignore=\"^/(dist|temp|.*\\.zip)\"",
    "db:migrate": "npx prisma migrate dev",
    "db:generate": "npx prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.20.2",
    "pdfkit-table": "^0.2.11",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.0",
    "electron": "^33.2.0",
    "nodemon": "^3.1.7",
    "prisma": "^5.20.0"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}